{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Blackdoor",
  "scopeName": "source.blackdoor",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#api" },
    { "include": "#methods" },
    { "include": "#calls" },
    { "include": "#properties" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.blackdoor",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.blackdoor",
      "begin": "([\"'])",
      "end": "\\1|$",
      "patterns": [
        { "name": "constant.character.escape.blackdoor", "match": "\\\\." }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.blackdoor", "match": "\\b(if|elif|else|while|for|return|break|continue|import|as)\\b" },
        { "name": "keyword.operator.word.blackdoor", "match": "\\b(and|or|not|in)\\b" },
        { "name": "storage.type.blackdoor", "match": "\\b(var|func)\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.blackdoor",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "name": "constant.numeric.blackdoor",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "builtins": {
      "name": "support.function.builtin.blackdoor",
      "match": "(?<!\\.)\\b(log|range|len|str|int|type|get_param|parse_target|exit)\\b(?=\\s*\\()"
    },
    "api": {
      "name": "support.function.api.blackdoor",
      "match": "(?<!\\.)\\b(scan|connect|disconnect|get_target|resolve_hostname|traces|get_security|probe_vuln|exploit_vuln|probe_firewall|bypass_firewall|crack|brute_web|local_crack|su|get_users|list_files|read_file|write_file|download|delete_file|file_size|upload|wget|get_trace_time|get_noise|get_cpu|get_my_ip|whoami|get_hostname|sleep|get_time|get_detection|my_files|read_local|save|write_local|local_mkdir|local_cp|local_mv|local_rm|file_type|pivot|pivot_clear|scrub_log|decrypt|detect_encryption|is_honeypot|extract_ips|extract_emails|extract_urls|extract_credentials|fast_bypass|grab_hash|hash_distance|hash_string|random_char|to_char|set_char|probe_layer|chip_layer|sqli|cmd_inject|browse|click|fill_form|submit_form|find_links|find_forms|smtp_connect|smtp_login|smtp_read|smtp_send)\\b(?=\\s*\\()"
    },
    "methods": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "punctuation.accessor.blackdoor" },
        "2": { "name": "support.function.method.blackdoor" }
      }
    },
    "calls": {
      "name": "entity.name.function.blackdoor",
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()"
    },
    "properties": {
      "name": "variable.other.property.blackdoor",
      "match": "(?<=\\.)[A-Za-z_]\\w*\\b"
    },
    "variables": {
      "name": "variable.other.blackdoor",
      "match": "\\b[A-Za-z_]\\w*\\b"
    },
    "operators": {
      "name": "keyword.operator.blackdoor",
      "match": "<<|>>|[-+*/%<>!=]=?|[?^~&|]"
    },
    "punctuation": {
      "name": "punctuation.blackdoor",
      "match": "[.,:;()\\[\\]{}]"
    }
  }
}

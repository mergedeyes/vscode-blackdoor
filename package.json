{
  "name": "blackdoor",
  "displayName": "Blackdoor (.bd)",
  "description": "Syntax highlighting and hover docs for Blackdoor .bd scripts",
  "version": "1.2.0",
  "publisher": "mergedeyes",
  "license": "GPL-3.0-only",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "keywords": ["blackdoor", "bd", "bdscript", "syntax", "game"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mergedeyes/vscode-blackdoor"
  },
  "bugs": { "url": "https://github.com/mergedeyes/vscode-blackdoor/issues" },
  "main": "./out/extension.js",
  "activationEvents": [],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.9.2"
  },
  "contributes": {
    "languages": [{
      "id": "blackdoor",
      "aliases": ["Blackdoor", "bd"],
      "extensions": [".bd"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "blackdoor",
      "scopeName": "source.blackdoor",
      "path": "./syntaxes/blackdoor.tmLanguage.json"
    }],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": ["keyword.control.blackdoor", "keyword.operator.word.blackdoor", "storage.type.blackdoor"],
            "settings": { "foreground": "#DB9E45" }
          },
          {
            "scope": ["variable.other.blackdoor", "variable.other.property.blackdoor"],
            "settings": { "foreground": "#B8B8B8" }
          },
          {
            "scope": ["support.function.builtin.blackdoor", "support.function.api.blackdoor", "support.function.method.blackdoor", "entity.name.function.blackdoor"],
            "settings": { "foreground": "#9A88DD" }
          },
          {
            "scope": ["constant.numeric.blackdoor", "constant.language.blackdoor", "string.quoted.blackdoor"],
            "settings": { "foreground": "#49B3E3" }
          },
          {
            "scope": ["comment.line.number-sign.blackdoor", "punctuation.blackdoor", "punctuation.accessor.blackdoor", "keyword.operator.blackdoor", "constant.character.escape.blackdoor"],
            "settings": { "foreground": "#9A9A9A" }
          }
        ]
      }
    }
  }
}
